{
  "name": "notur",
  "version": "1.5.3",
  "description": "Notur Extension Library - Bridge Runtime & SDK",
  "private": true,
  "workspaces": [
    "bridge",
    "sdk"
  ],
  "scripts": {
    "build:tailwind": "npx @tailwindcss/cli -i resources/tailwind/notur.css -o bridge/dist/tailwind.css",
    "build:bridge": "npx webpack-cli --mode production --config bridge/webpack.config.js",
    "build:sdk": "npx tsc --project sdk/tsconfig.json",
    "build": "npm run build:bridge && npm run build:tailwind && npm run build:sdk",
    "dev:bridge": "npx webpack-cli --mode development --watch --config bridge/webpack.config.js",
    "dev:tailwind": "npx @tailwindcss/cli -i resources/tailwind/notur.css -o bridge/dist/tailwind.css --watch",
    "test:frontend": "vitest run --config tests/Frontend/vitest.config.js",
    "test:frontend:coverage": "vitest run --config tests/Frontend/vitest.config.js --coverage",
    "test:e2e:browser": "npx playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^12.1.5",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  },
  "peerDependencies": {
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
